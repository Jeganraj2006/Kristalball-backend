# Local PostgreSQL only. Copy to .env and replace POSTGRES_PASSWORD before starting Docker.
POSTGRES_DB=kavach_dev
POSTGRES_USER=kavach_app
POSTGRES_PASSWORD=replace-with-a-long-local-development-password
POSTGRES_PORT=5433

# Backend-only. Do not place this value in frontend environment files.
DATABASE_URL=postgresql://kavach_app:replace-with-a-long-local-development-password@localhost:5433/kavach_dev?schema=public
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Use independently generated secrets of at least 32 characters. Keep backend-only.
JWT_ACCESS_SECRET=replace-with-a-unique-32-character-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-character-refresh-token-secret
